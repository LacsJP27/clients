{
  "//": "Type-checks the storage contracts, their suites, adapters, and reference implementations with no platform types. Run via `npm run lint:platform-neutral`.",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": [],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@bitwarden/storage-core": ["./platform-neutral-storage-core.ts"]
    }
  },
  "include": [
    "src/contract-testing/**/*.ts",
    "src/vault-storage-contract/**/*.ts",
    "src/secure-storage-contract/**/*.ts",
    "../storage-core/src/vault-storage/**/*.ts",
    "../storage-core/src/secure-storage/**/*.ts"
  ],
  "exclude": [
    "src/**/in-memory-vault-storage.contract.spec.ts",
    "src/**/vault-storage-adapter.contract.spec.ts",
    "src/**/secure-storage-adapter.contract.spec.ts"
  ]
}
